# media-dataset-prep ortak ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizle doldurun.
# .env asla git'e commit edilmez (.gitignore'da).

# ============================================================
# VERİ YOLLARI (opsiyonel — UI çalışırken dataset path elle girilir)
# ============================================================

# Ham görsellerin bulunduğu klasör (pipeline girişi)
DATASET_INPUT_DIR=/path/to/your/raw/images

# Temizlenmiş dataset çıktısı (pipeline çıkışı — Golden Set step output)
DATASET_OUTPUT_DIR=/path/to/cleaned/dataset

# Ara raporlar ve loglar (opsiyonel)
REPORTS_DIR=./reports
LOGS_DIR=./logs

# ============================================================
# META UI (NiceGUI — ui.py)
# ============================================================

# UI portu (default: 8200). Çalıştırma:
#   uv run --group ui python ui.py
UI_PORT=8200

# ============================================================
# OLLAMA (caption üretimi için — Step 06)
# ============================================================

# Lokal Ollama (default)
OLLAMA_HOST=http://localhost:11434

# media-captioner default model:
OLLAMA_MODEL=qwen2.5-vl:7b

# Daha güçlü alternatif (5-pass için önerilen):
# OLLAMA_MODEL=huihui_ai/qwen3-vl-abliterated:30b-a3b-instruct

# ============================================================
# RUNPOD / REMOTE OLLAMA (opsiyonel — GPU server kullanılıyorsa)
# ============================================================

# OLLAMA_HOST=http://your.runpod.ip:11434
# RUNPOD_API_KEY=your_runpod_key_here

# ============================================================
# WATERMARK MODEL (Step 04 — YOLOv8)
# ============================================================

# Default: ~/Models/watermarks_yolov8/watermarks_s_yolov8_v1.pt
# WATERMARK_MODEL_PATH=/path/to/watermarks_yolov8.pt

# ============================================================
# SECRETS (gerçek değerler ASLA commit edilmez)
# ============================================================

# HF_TOKEN=your_huggingface_token_here

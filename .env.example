# dataset-prep ortak ortam değişkenleri (environment variables)
# Bu dosyayı .env olarak kopyalayın ve kendi değerlerinizle doldurun
# .env asla git'e commit edilmez (.gitignore'da)

# ============================================================
# VERİ YOLLARI (paths)
# ============================================================

# Ham görsellerin bulunduğu klasör (pipeline girişi)
DATASET_INPUT_DIR=/path/to/your/raw/images

# Temizlenmiş dataset çıktısı (pipeline çıkışı)
DATASET_OUTPUT_DIR=/path/to/cleaned/dataset

# Ara raporlar ve loglar
REPORTS_DIR=./reports
LOGS_DIR=./logs

# ============================================================
# GRADIO UI (meta-orchestrator UI)
# ============================================================

GRADIO_HOST=0.0.0.0
GRADIO_PORT=7860

# ============================================================
# OLLAMA (caption üretimi için — 06-caption)
# ============================================================

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=huihui_ai/qwen3-vl-abliterated:30b-a3b-instruct

# ============================================================
# RUNPOD (uzaktan GPU server kullanılıyorsa)
# ============================================================

# RUNPOD_HOST=http://your.runpod.ip:11434
# RUNPOD_API_KEY=your_runpod_key_here

# ============================================================
# SECRETS (gerekiyorsa — burada gerçek değerler ASLA commit edilmez)
# ============================================================

# HF_TOKEN=your_huggingface_token_here
